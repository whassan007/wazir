# Wazir Meta-Harness Environment Configuration

# Runtime URLs
WAZIR_OLLAMA_URL=http://localhost:11434
WAZIR_LMSTUDIO_URL=http://localhost:1234/v1

# Networking & Server Ports
PORT=4800
WAZIR_HOST=127.0.0.1
WAZIR_COMPUTER_ID=local
WAZIR_COMPUTER_NAME=local-workstation

# Control-plane API URL. Set on a CLI/worker host to enable distributed mode:
# the CLI pulls remote computers/runtimes/models into its Scheduler and
# dispatches non-local tasks through this API's task-pull loop. Leave unset
# for local-only (single-machine) operation.
# WAZIR_API_URL=http://localhost:4800

# PostgreSQL connection string for @wazir/database's PostgresStore. Leave
# unset to use the local JSON file store (~/.wazir/wazir.json) instead.
# WAZIR_DATABASE_URL=postgres://wazir:wazir@localhost:5432/wazir
# --- Control-plane authentication -------------------------------------------
# Operator bearer token for /api/v1/* and /executions (CLI, web dashboard and
# any other client send it as `Authorization: Bearer`). Required whenever the
# API binds anything other than loopback. Generate with: openssl rand -hex 32
# WAZIR_API_TOKEN=

# Cluster secret a worker must present to register (or re-claim) a computer
# id. Set the same value on the API and every worker.
# WAZIR_REGISTRATION_TOKEN=

# Optional pre-shared per-computer token for a worker (stable identity across
# restarts without the registration secret).
# WAZIR_WORKER_TOKEN=

# Extra environment variable names (comma-separated) forwarded to tool
# subprocesses. By default only PATH/HOME/LANG/TERM-style variables reach a
# tool command, never API keys or database URLs.
# WAZIR_CHILD_ENV=

# OS sandbox for tool subprocesses: auto (default: bwrap on Linux,
# sandbox-exec on macOS, falls back to none with a warning), bwrap,
# sandbox-exec, or none. `wa doctor` shows the effective mode and why.
# WAZIR_SANDBOX=auto

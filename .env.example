# Wazir Meta-Harness Environment Configuration

# Runtime URLs
WAZIR_OLLAMA_URL=http://localhost:11434
WAZIR_LMSTUDIO_URL=http://localhost:1234/v1

# Networking & Server Ports
PORT=4800
WAZIR_HOST=127.0.0.1
WAZIR_COMPUTER_ID=local
WAZIR_COMPUTER_NAME=local-workstation

# Control-plane API URL. Set on a CLI/worker host to enable distributed mode:
# the CLI pulls remote computers/runtimes/models into its Scheduler and
# dispatches non-local tasks through this API's task-pull loop. Leave unset
# for local-only (single-machine) operation.
# WAZIR_API_URL=http://localhost:4800

# PostgreSQL connection string for @wazir/database's PostgresStore. Leave
# unset to use the local JSON file store (~/.wazir/wazir.json) instead.
# WAZIR_DATABASE_URL=postgres://wazir:wazir@localhost:5432/wazir
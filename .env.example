# Rook project environment file (example)

# API credentials (replace placeholders)
HF_TOKEN=your_hf_token_here

# Database URL for PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/rook_db

# SMTP settings for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example@example.com
SMTP_PASS=your_smtp_password_here

# Application secrets (to be filled in)
API_SECRET_KEY=super_secret_key_change_me

# Environment-specific settings
ENVIRONMENT=development
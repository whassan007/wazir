{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wazir Desktop",
  "version": "0.1.0",
  "identifier": "ai.wazir.desktop",
  "build": {
    "beforeDevCommand": "bash -c 'cd \"$(pwd)/../..\" && npm run start:dashboard'",
    "devUrl": "http://127.0.0.1:4801",
    "frontendDist": "../../web/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wazir Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

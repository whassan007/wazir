<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Headless launchd daemon for the Wazir worker — distinct from the GUI
  Wazir.app launcher in scripts/build-dmg.sh (which starts the API + web
  dashboard and opens a browser). This is for running a worker unattended
  in the background on a Mac used as a compute target, with no dashboard.

  Install as a LaunchAgent (runs as the logged-in user, can reach that
  user's Ollama/LM Studio):
    cp ai.wazir.worker.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.wazir.worker.plist

  Or as a LaunchDaemon (runs at boot, before login, as root — copy to
  /Library/LaunchDaemons/ instead and load with sudo). Adjust the paths
  below either way to match your install location and `which node` output.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.wazir.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/opt/wazir/apps/worker/dist/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/wazir</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>WAZIR_SERVER_URL</key>
        <string>http://localhost:4800</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/wazir-worker.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/wazir-worker.error.log</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>

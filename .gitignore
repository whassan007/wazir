# Wazir project .gitignore

# Node.js / npm
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
# TS output has occasionally leaked into src/ instead of dist/ from a stale
# tsconfig (found and cleaned up in packages/shared) — no package here hand-
# writes .js/.d.ts under src/, so these are always compiled output. Leading
# **/ is required so this matches at any depth (packages/*/src/...), not
# just a top-level ./src/.
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map

# IDE / editors
.vscode/
.idea/
.claude/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db

# Environment and secrets (keep .env.example tracked)
.env
.env.local

# Logs
logs/
npm-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/

# Build artifacts specific to this project
*.log
*.cache
*.zip
*.tar.gz
*.dmg

# Other
.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
# esbuild bundle output (scripts/bundle.mjs)
bin/wa.js
bin/wa.js.map

# test plan runner artifacts (scripts/tui-test-plan.mjs)
test-plan-report.json
.test-plan-vitest.json

# test plan runner artifacts (scripts/agent-execution-test-plan.mjs)
agent-execution-test-plan-report.json
.test-plan-vitest-agent.json

# live scenario test report (apps/cli/tests/buildcpp.e2e.test.ts)
buildcpp-test-report.json
